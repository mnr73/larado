# Custom MySQL settings (mounted at /etc/mysql/conf.d/larado.cnf).
# Everything is commented: MySQL defaults apply. Uncomment what you need,
# then: docker compose restart mysql
[mysqld]
# max_connections = 500
# innodb_buffer_pool_size = 1G
# innodb_log_buffer_size = 256M
# innodb_log_file_size = 1G
# innodb_write_io_threads = 16
# innodb_flush_log_at_trx_commit = 2
# slow_query_log = 1
# long_query_time = 1
