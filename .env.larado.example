# --- larado (appended to .env by install.sh) ---
# shared image name for all projects (tags :prod / :dev); lowercase only
LARADO_IMAGE=larado
APP_PORT=8000
QUEUE_REPLICAS=2
PHP_MEMORY_LIMIT=512M

# dev only (ignored by compose.yml):
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
PMA_PORT=8080
XDEBUG_MODE=develop,debug
# build-time uid/gid of www-data in the dev image (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# LOCAL ONLY: enables compose.dev.yml (xdebug, phpMyAdmin, db/redis ports). Never set on the server.
COMPOSE_FILE=compose.yml:compose.dev.yml
